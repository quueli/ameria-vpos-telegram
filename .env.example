# Copy to .env and fill in. One file, shared by the bot and the server.

# Telegram bot
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ALLOWED_IDS=123456789,987654321

# AmeriaBank vPOS merchant credentials
AMERIA_CLIENT_ID=YOUR_CLIENT_ID
AMERIA_USERNAME=YOUR_VPOS_USERNAME
AMERIA_PASSWORD=YOUR_VPOS_PASSWORD
# true  = sandbox host (servicestest.ameriabank.am)
# false = live host (services.ameriabank.am)
AMERIA_TEST_MODE=true

# Where the bank returns the customer's browser after payment. Must be a domain
# registered for this merchant with the bank. The bot confirms status by polling.
BACK_URL=https://example.com/payment-result

# Payment tracking
POLL_INTERVAL_MS=8000
PAYMENT_TTL_MS=1200000

# FX conversion to AMD: live rates unless false. RATE_* pin a fixed AMD-per-unit
# rate and skip the live update for that currency.
LIVE_RATES=true
# RATE_USD=390
# RATE_EUR=430

# Express server
PORT=3000
